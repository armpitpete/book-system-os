[Unit]
Description=Book System OS API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/book-system
EnvironmentFile=/opt/book-system/config/env
ExecStart=/opt/book-system/.venv/bin/uvicorn app.api.app:app --host ${BOOK_BIND_HOST} --port ${BOOK_BIND_PORT}
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/book-system/books /opt/book-system/logs

[Install]
WantedBy=multi-user.target
