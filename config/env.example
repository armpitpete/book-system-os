# Book System OS runtime config
BOOK_SYSTEM_ROOT=/opt/book-system
BOOK_SYSTEM_ENV=production
BOOK_API_KEY=replace-with-a-long-random-secret
BOOK_ADMIN_USERNAME=replace-with-an-admin-name
BOOK_ADMIN_PASSWORD=replace-with-a-long-random-password
BOOK_BIND_HOST=127.0.0.1
BOOK_BIND_PORT=8080
BOOK_WORKER_POLL_SECONDS=2

# H-04 single-server resource limits
BOOK_MAX_REQUEST_BYTES=6291456
BOOK_MAX_MANUSCRIPT_BYTES=5242880
BOOK_MAX_ACTIVE_JOBS=20
BOOK_EXPORT_COMMAND_TIMEOUT_SECONDS=300
BOOK_MAX_JOB_BYTES=209715200
BOOK_MAX_TOTAL_STORAGE_BYTES=10737418240

# H-05 readiness and operational observability
BOOK_WORKER_SERVICE_HEARTBEAT_SECONDS=2
BOOK_READINESS_WORKER_MAX_AGE_SECONDS=15
BOOK_READINESS_MIN_FREE_BYTES=536870912
BOOK_READINESS_QUEUED_WARN_SECONDS=900
BOOK_READINESS_RUNNING_FAIL_SECONDS=900
